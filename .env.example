# 將本檔複製為同目錄的 .env，再填入自己的資料。Git 會忽略 .env。

# Threads 發佈
# 填入測試帳戶的數字使用者 ID。
THREADS_ACCOUNT_ID=
# 填入該帳戶的長效 Threads User Access Token，權限需包括 threads_basic 和 threads_content_publish。
THREADS_ACCESS_TOKEN=

# OpenRouter 撰稿及編輯預覽
OPENROUTER_API_KEY=
# 填入支援結構化輸出的模型 ID，格式為 provider/model。
OPENROUTER_MODEL=

# 只在排程主機指定正式圖卡映像。開發 checkout 預設沿用 Compose project 名稱。
# FEEDROOM_CARDS_IMAGE=feedroom-cards:latest

# 本機 Docker 預設用 threads-state volume 保存 SQLite 發佈紀錄。
# 如日後需要與 Cloudflare 共用發佈紀錄，請同時填寫以下四項。
# FEEDROOM_R2_ACCOUNT_ID=
# FEEDROOM_R2_BUCKET=
# FEEDROOM_R2_ACCESS_KEY_ID=
# FEEDROOM_R2_SECRET_ACCESS_KEY=
